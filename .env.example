# Required for bookings, feedback and live chat. Vercel's Upstash integration
# sets KV_REST_API_URL / KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required for booking enquiry notifications.
RESEND_API_KEY=
ADMIN_EMAIL=anselmpius@gmail.com

# Use a verified domain sender in production, for example:
# RESEND_FROM_EMAIL="Anselm Long Bookings <bookings@anselmlong.com>"
# The default code fallback is Resend's onboarding sender for account/testing delivery.
RESEND_FROM_EMAIL=

# Public site origin used to build the editable quote link inside notifications.
NEXT_PUBLIC_URL=https://photos.anselmlong.com

# Optional fallback if email delivery fails and the Telegram bot is configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Google Drive photo ingest.
# The folder must be shared as "Anyone with the link can view".
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_FOLDER_ID=1NEJ1ePEb41NWw0CAvKXlNEwigsPQ6eKN
DRIVE_SYNC_CATEGORY=events
DRIVE_SYNC_FEATURED=false
DRIVE_SYNC_SINCE=2026-07-01
